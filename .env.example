ALIYUN_DASHSCOPE_API_KEY=

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=20
CORS_ALLOW_ORIGINS=https://your-domain.example
APP_ENV=production
APP_CODE=wedding_ai_tool

# Database
# Production must use MySQL. Do not commit real credentials.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/wedding_ai_tool?charset=utf8mb4
# Local tests may still use SQLITE_DB_PATH, but production startup rejects SQLite.
# SQLITE_DB_PATH=/app/data/app.db

# Object storage: local or oss
OBJECT_STORAGE_MODE=oss
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=

# Auth
# MySQL-first internal test can keep auth disabled until the user center is ready.
# Do not expose a public production domain with AUTH_ENABLED=false.
AUTH_ENABLED=false
AUTH_MODE=local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_SECONDS=43200
AUTH_COOKIE_SECURE=true
# Optional backend/API-only temporary users. The C-end login page is reserved for platform SSO.
# APP_USERS_JSON={"admin":{"password":"CHANGE_ME","user_id":"admin"}}

# User center SSO, enable later:
# AUTH_ENABLED=true
# AUTH_MODE=platform_sso
USER_CENTER_BASE_URL=
USER_CENTER_LOGIN_URL=https://user-center.example/login?callback={callback}&app_code={app_code}
USER_CENTER_CLIENT_ID=
USER_CENTER_CLIENT_SECRET=
USER_CENTER_SSO_EXCHANGE_PATH=/api/v1/sso/exchange
USER_CENTER_CALLBACK_SUCCESS_PATH=/

# Cost controls
RATE_LIMIT_ENABLED=true
MAX_CREATE_TASKS_PER_HOUR=20
MAX_CREATE_TASKS_PER_DAY=80
MAX_UPLOADS_PER_HOUR=60

# Retry and cleanup
MAX_TASK_RETRIES=2
TASK_RETRY_DELAY_SECONDS=10
CLEANUP_ENABLED=true
UPLOAD_RETENTION_DAYS=30
OUTPUT_RETENTION_DAYS=30
DELETED_RECORD_RETENTION_DAYS=30
